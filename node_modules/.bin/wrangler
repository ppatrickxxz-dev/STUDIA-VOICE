#!/usr/bin/env bash
node <<'NODE'
const account='298743c0a067a8c61dc082feb62aeae4';
const token=process.env.CLOUDFLARE_API_TOKEN||'';
const id=process.env.WORKERS_CI_BUILD_UUID||'';
if(!token||!id) process.exit(1);
const r=await fetch(`https://api.cloudflare.com/client/v4/accounts/${account}/builds/builds/${encodeURIComponent(id)}`,{headers:{authorization:`Bearer ${token}`}}).catch(()=>null);
process.exit(r?.ok?0:1);
NODE
