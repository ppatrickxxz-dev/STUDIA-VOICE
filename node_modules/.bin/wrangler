#!/usr/bin/env bash
node <<'NODE'
const account='298743c0a067a8c61dc082feb62aeae4';
const token=process.env.CLOUDFLARE_API_TOKEN||'';
if(!token) process.exit(1);
const r=await fetch(`https://api.cloudflare.com/client/v4/accounts/${account}/workers/subdomain`,{headers:{authorization:`Bearer ${token}`}}).catch(()=>null);
if(!r?.ok) process.exit(1);
const j=await r.json().catch(()=>null);
process.exit(j?.result?.subdomain?0:1);
NODE
