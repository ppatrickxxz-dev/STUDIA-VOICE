#!/usr/bin/env bash
set -u
MARKER='.cloudflare-control-state.txt'
BRANCH="${WORKERS_CI_BRANCH:-infra/cloudflare-runtime-v3}"
SHA="${WORKERS_CI_COMMIT_SHA:-unknown}"

if [ -f "$MARKER" ]; then
  exit 97
fi

remote="$(git remote get-url origin 2>/dev/null || true)"
case "$remote" in
  *x-access-token*|*oauth*|*github_pat*) remote_has_embedded_auth=yes ;;
  *) remote_has_embedded_auth=no ;;
esac

{
  echo "sha=$SHA"
  echo "branch=$BRANCH"
  echo "workers_ci=${WORKERS_CI:-unset}"
  echo "build_uuid_present=$([ -n "${WORKERS_CI_BUILD_UUID:-}" ] && echo yes || echo no)"
  echo "cloudflare_api_token_present=$([ -n "${CLOUDFLARE_API_TOKEN:-}" ] && echo yes || echo no)"
  echo "cloudflare_account_id_present=$([ -n "${CLOUDFLARE_ACCOUNT_ID:-}" ] && echo yes || echo no)"
  echo "cf_api_token_present=$([ -n "${CF_API_TOKEN:-}" ] && echo yes || echo no)"
  echo "remote_has_embedded_auth=$remote_has_embedded_auth"
  echo 'matching_env_names:'
  env | cut -d= -f1 | grep -Ei 'cloudflare|workers_ci|wrangler|cf_api' | sort || true
} > "$MARKER"

git config user.name 'cloudflare-control-probe'
git config user.email 'cloudflare-control-probe@users.noreply.github.com'
git add -f "$MARKER"
git commit -m 'chore(cloudflare): publish sanitized control-plane state' >/dev/null 2>&1 || true
git push origin "HEAD:$BRANCH" >/dev/null 2>&1 || exit 96
exit 95
