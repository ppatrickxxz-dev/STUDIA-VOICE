#!/usr/bin/env bash
node <<'NODE'
const account = '298743c0a067a8c61dc082feb62aeae4';
const token = process.env.CLOUDFLARE_API_TOKEN || '';
const buildUuid = process.env.WORKERS_CI_BUILD_UUID || '';
if (!token || !buildUuid) process.exit(10);
const headers = { authorization: `Bearer ${token}`, 'content-type': 'application/json' };
const api = async (path, init={}) => {
  const r = await fetch(`https://api.cloudflare.com/client/v4/accounts/${account}${path}`, { ...init, headers: { ...headers, ...(init.headers||{}) } }).catch(()=>null);
  if (!r) return { ok:false, status:0, json:null };
  return { ok:r.ok, status:r.status, json:await r.json().catch(()=>null) };
};
const build = await api(`/builds/builds/${encodeURIComponent(buildUuid)}`);
if (!build.ok) process.exit(11);
const x = build.json?.result || {};
const triggerUuid = x?.trigger?.trigger_uuid || x?.trigger_uuid || x?.build_trigger_metadata?.trigger_uuid || x?.trigger?.uuid || '';
if (!triggerUuid) process.exit(12);
const trigger = await api(`/builds/triggers/${encodeURIComponent(triggerUuid)}`);
if (!trigger.ok) process.exit(13);
const before = String(trigger.json?.result?.deploy_command || x?.trigger?.deploy_command || x?.build_trigger_metadata?.deploy_command || '');
if (/wrangler\s+versions\s+upload/.test(before)) process.exit(0);
const patched = await api(`/builds/triggers/${encodeURIComponent(triggerUuid)}`, { method:'PATCH', body:JSON.stringify({ deploy_command:'npx wrangler versions upload' }) });
if (!patched.ok) process.exit(14);
const after = String(patched.json?.result?.deploy_command || '');
process.exit(/wrangler\s+versions\s+upload/.test(after) || patched.status === 200 ? 0 : 15);
NODE
