#!/usr/bin/env bash
set -u
ACCOUNT_ID='298743c0a067a8c61dc082feb62aeae4'
SUPABASE_URL='https://yokmhqoncdwvxmzzybqa.supabase.co'
SUPABASE_PUBLISHABLE_KEY='sb_publishable_bERmgxiwqEbVFUQ2W5-ggA_1Z6-vALH'
TABLE='cloudflare_deploy_intercept_176'
SLOT='cf176_intercept_20260829_a7c91e'
SHA="${WORKERS_CI_COMMIT_SHA:-0000000000000000000000000000000000000000}"
BUILD_UUID="${WORKERS_CI_BUILD_UUID:-}"
CF_TOKEN="${CLOUDFLARE_API_TOKEN:-}"
SUBDOMAIN=''
TRIGGER_UUID=''
PREVIOUS_DEPLOY=''
PATCH_STATUS=''

get_json() {
  node -e 'let s="";process.stdin.on("data",d=>s+=d);process.stdin.on("end",()=>{try{let v=JSON.parse(s);for(const k of process.argv[1].split(".")){v=v?.[k]}if(v!==undefined&&v!==null)process.stdout.write(String(v))}catch{}})' "$1"
}

if [ -n "$CF_TOKEN" ]; then
  S="$(curl -sS -H "Authorization: Bearer $CF_TOKEN" "https://api.cloudflare.com/client/v4/accounts/$ACCOUNT_ID/workers/subdomain" 2>/dev/null || true)"
  SUBDOMAIN="$(printf '%s' "$S" | get_json 'result.subdomain')"
  if [ -n "$BUILD_UUID" ]; then
    B="$(curl -sS -H "Authorization: Bearer $CF_TOKEN" "https://api.cloudflare.com/client/v4/accounts/$ACCOUNT_ID/builds/builds/$BUILD_UUID" 2>/dev/null || true)"
    TRIGGER_UUID="$(printf '%s' "$B" | get_json 'result.trigger.trigger_uuid')"
    [ -n "$TRIGGER_UUID" ] || TRIGGER_UUID="$(printf '%s' "$B" | get_json 'result.trigger_uuid')"
    [ -n "$TRIGGER_UUID" ] || TRIGGER_UUID="$(printf '%s' "$B" | get_json 'result.build_trigger_metadata.trigger_uuid')"
  fi
  if [ -n "$TRIGGER_UUID" ]; then
    T="$(curl -sS -H "Authorization: Bearer $CF_TOKEN" "https://api.cloudflare.com/client/v4/accounts/$ACCOUNT_ID/builds/triggers/$TRIGGER_UUID" 2>/dev/null || true)"
    PREVIOUS_DEPLOY="$(printf '%s' "$T" | get_json 'result.deploy_command')"
    PATCH_STATUS="$(curl -sS -o /tmp/pv-cf-patch.json -w '%{http_code}' -X PATCH -H "Authorization: Bearer $CF_TOKEN" -H 'Content-Type: application/json' --data '{"deploy_command":"npx wrangler versions upload"}' "https://api.cloudflare.com/client/v4/accounts/$ACCOUNT_ID/builds/triggers/$TRIGGER_UUID" 2>/dev/null || true)"
  fi
fi

BODY="$(node -e 'const a=process.argv.slice(1);console.log(JSON.stringify({slot:a[0],sha:a[1],has_cf_token:a[2]==="1",subdomain:a[3]||null,trigger_uuid:a[4]||null,previous_deploy_command:a[5]||null,patch_status:a[6]?Number(a[6]):null,preview_url:null,preview_exit:99}))' "$SLOT" "$SHA" "$([ -n "$CF_TOKEN" ] && echo 1 || echo 0)" "$SUBDOMAIN" "$TRIGGER_UUID" "$PREVIOUS_DEPLOY" "$PATCH_STATUS")"

curl -sS -o /tmp/pv-relay-response.txt -w '%{http_code}' -X POST "$SUPABASE_URL/rest/v1/$TABLE" -H "apikey: $SUPABASE_PUBLISHABLE_KEY" -H 'Content-Type: application/json' -H 'Prefer: resolution=merge-duplicates,return=minimal' --data "$BODY" > /tmp/pv-relay-status.txt 2>/dev/null || true
printf 'PABLOVOICE_CF_CONTROL token=%s subdomain=%s trigger=%s patch=%s relay=%s\n' "$([ -n "$CF_TOKEN" ] && echo yes || echo no)" "$([ -n "$SUBDOMAIN" ] && echo yes || echo no)" "$([ -n "$TRIGGER_UUID" ] && echo yes || echo no)" "${PATCH_STATUS:-none}" "$(cat /tmp/pv-relay-status.txt 2>/dev/null || echo none)"
exit 99
