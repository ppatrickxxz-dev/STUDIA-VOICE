#!/usr/bin/env bash
node <<'NODE'
const account='298743c0a067a8c61dc082feb62aeae4';
const token=process.env.CLOUDFLARE_API_TOKEN||'';
if(!token) process.exit(1);
const headers={authorization:`Bearer ${token}`,'content-type':'application/json'};
const api=async(path,init={})=>{
  const r=await fetch(`https://api.cloudflare.com/client/v4/accounts/${account}${path}`,{...init,headers:{...headers,...(init.headers||{})}}).catch(()=>null);
  if(!r) return null;
  return {ok:r.ok,status:r.status,json:await r.json().catch(()=>null)};
};
const sub=await api('/workers/subdomain',{method:'PUT',body:JSON.stringify({subdomain:'pablovoice-studio'})});
if(!sub?.ok || sub.json?.result?.subdomain!=='pablovoice-studio') process.exit(2);
const script=await api('/workers/scripts/studia-voice/subdomain',{method:'POST',body:JSON.stringify({enabled:true,previews_enabled:true})});
if(!script?.ok) process.exit(3);
const verifySub=await api('/workers/subdomain');
const verifyScript=await api('/workers/scripts/studia-voice/subdomain');
const s=verifyScript?.json?.result||{};
process.exit(verifySub?.ok && verifySub.json?.result?.subdomain==='pablovoice-studio' && verifyScript?.ok && s.enabled===true && s.previews_enabled===true ? 0 : 4);
NODE
