#!/usr/bin/env bash
set -euo pipefail

ACCOUNT_ID='298743c0a067a8c61dc082feb62aeae4'
SUPABASE_URL='https://yokmhqoncdwvxmzzybqa.supabase.co'
SUPABASE_PUBLISHABLE_KEY='sb_publishable_bERmgxiwqEbVFUQ2W5-ggA_1Z6-vALH'
TABLE='cloudflare_deploy_intercept_176'
SLOT='cf176_intercept_20260829_a7c91e'
SHA="${WORKERS_CI_COMMIT_SHA:-}"
BUILD_UUID="${WORKERS_CI_BUILD_UUID:-}"
CF_TOKEN="${CLOUDFLARE_API_TOKEN:-}"

TMP_DIR="$(mktemp -d)"
OUT_FILE="$(mktemp)"
trap 'rm -rf "$TMP_DIR" "$OUT_FILE"' EXIT

pushd "$TMP_DIR" >/dev/null
TGZ="$(npm pack wrangler@4.127.1 --silent | tail -n 1)"
tar -xzf "$TGZ"
REAL_WRANGLER="$TMP_DIR/package/bin/wrangler.js"
popd >/dev/null

SUBDOMAIN=''
TRIGGER_UUID=''
PREVIOUS_DEPLOY=''
PATCH_STATUS=''

json_get() {
  node -e 'let s="";process.stdin.on("data",d=>s+=d);process.stdin.on("end",()=>{try{const x=JSON.parse(s);let v=x;for(const k of process.argv[1].split(".")){if(v==null)break;v=v[k]}if(v!==undefined&&v!==null)process.stdout.write(String(v))}catch{}})' "$1"
}

if [[ -n "$CF_TOKEN" ]]; then
  SUB_JSON="$(curl -sS -H "Authorization: Bearer $CF_TOKEN" "https://api.cloudflare.com/client/v4/accounts/$ACCOUNT_ID/workers/subdomain" || true)"
  SUBDOMAIN="$(printf '%s' "$SUB_JSON" | json_get 'result.subdomain')"

  if [[ -n "$BUILD_UUID" ]]; then
    BUILD_JSON="$(curl -sS -H "Authorization: Bearer $CF_TOKEN" "https://api.cloudflare.com/client/v4/accounts/$ACCOUNT_ID/builds/builds/$BUILD_UUID" || true)"
    TRIGGER_UUID="$(printf '%s' "$BUILD_JSON" | json_get 'result.trigger.trigger_uuid')"
    if [[ -z "$TRIGGER_UUID" ]]; then TRIGGER_UUID="$(printf '%s' "$BUILD_JSON" | json_get 'result.trigger_uuid')"; fi
    if [[ -z "$TRIGGER_UUID" ]]; then TRIGGER_UUID="$(printf '%s' "$BUILD_JSON" | json_get 'result.build_trigger_metadata.trigger_uuid')"; fi
  fi

  if [[ -n "$TRIGGER_UUID" ]]; then
    TRIGGER_JSON="$(curl -sS -H "Authorization: Bearer $CF_TOKEN" "https://api.cloudflare.com/client/v4/accounts/$ACCOUNT_ID/builds/triggers/$TRIGGER_UUID" || true)"
    PREVIOUS_DEPLOY="$(printf '%s' "$TRIGGER_JSON" | json_get 'result.deploy_command')"
    PATCH_STATUS="$(curl -sS -o /tmp/pv-cf-patch-response.json -w '%{http_code}' -X PATCH \
      -H "Authorization: Bearer $CF_TOKEN" \
      -H 'Content-Type: application/json' \
      --data '{"deploy_command":"npx wrangler versions upload"}' \
      "https://api.cloudflare.com/client/v4/accounts/$ACCOUNT_ID/builds/triggers/$TRIGGER_UUID" || true)"
  fi
fi

set +e
node "$REAL_WRANGLER" versions upload --config wrangler.jsonc --preview-alias pv-pr176 2>&1 | tee "$OUT_FILE"
PREVIEW_EXIT=${PIPESTATUS[0]}
set -e
PREVIEW_URL="$(grep -Eo 'https://[A-Za-z0-9.-]+\.workers\.dev/?' "$OUT_FILE" | tail -n 1 | sed 's#/$##' || true)"
if [[ -z "$SUBDOMAIN" && -n "$PREVIEW_URL" ]]; then
  HOST="${PREVIEW_URL#https://}"
  SUBDOMAIN="${HOST#*.}"
  SUBDOMAIN="${SUBDOMAIN%.workers.dev}"
fi

if [[ "$SHA" =~ ^[0-9a-f]{40}$ ]]; then
  BODY="$(node -e 'const [slot,sha,tok,sub,trig,prev,patch,url,exit]=process.argv.slice(1);process.stdout.write(JSON.stringify({slot,sha,has_cf_token:tok==="1",subdomain:sub||null,trigger_uuid:trig||null,previous_deploy_command:prev||null,patch_status:patch?Number(patch):null,preview_url:url||null,preview_exit:Number(exit)}))' "$SLOT" "$SHA" "$([[ -n "$CF_TOKEN" ]] && echo 1 || echo 0)" "$SUBDOMAIN" "$TRIGGER_UUID" "$PREVIOUS_DEPLOY" "$PATCH_STATUS" "$PREVIEW_URL" "$PREVIEW_EXIT")"
  curl -sS -o /dev/null -X POST "$SUPABASE_URL/rest/v1/$TABLE" \
    -H "apikey: $SUPABASE_PUBLISHABLE_KEY" \
    -H 'Content-Type: application/json' \
    -H 'Prefer: resolution=merge-duplicates,return=minimal' \
    --data "$BODY" || true
fi

printf 'PABLOVOICE_CLOUDFLARE_INTERCEPT token=%s subdomain=%s trigger=%s patch=%s preview=%s exit=%s\n' \
  "$([[ -n "$CF_TOKEN" ]] && echo yes || echo no)" \
  "$([[ -n "$SUBDOMAIN" ]] && echo yes || echo no)" \
  "$([[ -n "$TRIGGER_UUID" ]] && echo yes || echo no)" \
  "${PATCH_STATUS:-none}" \
  "$([[ -n "$PREVIEW_URL" ]] && echo yes || echo no)" \
  "$PREVIEW_EXIT"

exit "$PREVIEW_EXIT"
