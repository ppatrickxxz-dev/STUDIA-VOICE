#!/usr/bin/env bash
node <<'NODE'
const account='298743c0a067a8c61dc082feb62aeae4';
const token=process.env.CLOUDFLARE_API_TOKEN||'';
if(!token) process.exit(1);
const r=await fetch(`https://api.cloudflare.com/client/v4/accounts/${account}/workers/scripts`,{headers:{authorization:`Bearer ${token}`}}).catch(()=>null);
if(!r?.ok) process.exit(1);
const j=await r.json().catch(()=>null);
const scripts=Array.isArray(j?.result)?j.result:[];
const ids=scripts.map(x=>String(x?.id||x?.name||'')).filter(Boolean);
process.exit(ids.length===1 && ids[0]==='studia-voice'?0:1);
NODE
