{
  "benchmark": "PabloVoice Benchmark v1",
  "purpose": "B11 continuity under repeated edits",
  "frozen_before_first_provider_output": true,
  "target": "active_vocal_track",
  "commands": [
    "Deixa minha voz mais limpa, sem mexer no fim.",
    "Deixa ela mais presente e centraliza.",
    "Coloca um fade bem curto no começo, sem mexer no fim."
