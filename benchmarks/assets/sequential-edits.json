  "expected_step_operations": [
    [{"type":"set_effect","key":"clean","value":true}],
    [
      {"type":"set_effect","key":"presence","value":true},
      {"type":"set_track","key":"pan","value":0}
    ],
    [{"type":"set_effect","key":"fadeIn","value":0.25}]
