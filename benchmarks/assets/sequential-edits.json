  "must_preserve_across_all_steps": [
    "project identity",
    "lyrics",
    "track order",
    "non-selected tracks",
    "selected source asset identity",
    "selected duration/sample-rate/channel layout",
    "selected offset/trim/gain/mute/solo"
  ],
  "score_requires_acoustic_evidence": true,
  "implementation_readiness_is_not_pass": true
}
